{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "surface": {
      "canvas": { "$value": "oklch(0.14 0.015 260)", "$type": "color" },
      "elevated": { "$value": "oklch(0.19 0.018 260)", "$type": "color" },
      "glass": { "$value": "oklch(0.22 0.02 260 / 0.72)", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "oklch(0.96 0.008 260)", "$type": "color" },
      "secondary": { "$value": "oklch(0.76 0.015 260)", "$type": "color" }
    },
    "brand": {
      "accent": { "$value": "oklch(0.74 0.17 160)", "$type": "color" },
      "cta": { "$value": "oklch(0.82 0.18 85)", "$type": "color" }
    }
  },
  "typography": {
    "step0": { "$value": "clamp(1rem, 0.95rem + 0.25vw, 1.125rem)", "$type": "dimension" },
    "step2": { "$value": "clamp(1.5rem, 1.3rem + 1vw, 2.25rem)", "$type": "dimension" },
    "step4": { "$value": "clamp(2.25rem, 1.8rem + 2.2vw, 3.75rem)", "$type": "dimension" }
  }
