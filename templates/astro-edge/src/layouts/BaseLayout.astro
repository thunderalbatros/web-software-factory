---
const title = "{{PROJECT_NAME}} — Sitio Oficial";
const description = "{{PROJECT_NAME}} — Construido con Astro 5 + Cloudflare Workers Static Assets desde la Web Software Factory.";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="stylesheet" href="/styles/design-tokens.css">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{PROJECT_NAME}}",
    "url": "{{PROJECT_DOMAIN}}"
  }
  </script>
  <script type="speculationrules">
  {
    "prerender": [
      {
        "where": { "href_matches": "/*" },
        "eagerness": "moderate"
      }
    ],
    "prefetch": [
      {
        "where": { "href_matches": "/*" },
        "eagerness": "moderate"
      }
    ]
  }
  </script>
</head>
<body>
  <header aria-label="Navegación principal">
    <nav aria-label="Menú principal">
      <strong>{{PROJECT_NAME}}</strong>
    </nav>
  </header>
  <slot />
  <footer aria-label="Pie de página legal">
    <small>&copy; 2026 {{PROJECT_NAME}}. Todos los derechos reservados.</small>
  </footer>
</body>
</html>
