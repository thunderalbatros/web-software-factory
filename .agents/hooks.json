{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./tools/intelligence/agy_token_guard_hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./tools/intelligence/agy_token_guard_hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
