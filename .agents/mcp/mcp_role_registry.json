      "patternOrigin": "aws-samples/sample-mcp-security-scanner",
      "audience": "urn:web-software-factory:mcp:delta-security-scanner",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
      "hitlGate": false,
      "maxSummaryTokens": 300,
      "reportOutputs": {
        "semgrepDir": ".agents/security_reports/.semgrep",
        "trivyDir": ".agents/security_reports/.trivy",
