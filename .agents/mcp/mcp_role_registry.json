      "description": "Acceso a archivos restringido por lista blanca (projects/<active-slug>/), bloqueando explícitamente .agents/sealed_envelope_evals/ para los implementadores.",
      "tools": ["filesystem_scoped_read", "filesystem_scoped_write"]
    },
    "git-readonly-mcp": {
      "id": "git-readonly-mcp",
      "category": "vcs_fs_db_edge",
      "command": "node",
      "args": ["tools/mcp/mcp_omni_rag_server.mjs", "--profile=git-readonly-mcp"],
      "audience": "urn:web-software-factory:mcp:git-readonly-mcp",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
      "hitlGate": false,
      "blockedGitSubcommands": ["commit", "push", "reset", "rebase", "merge", "checkout -B", "branch -D"],
