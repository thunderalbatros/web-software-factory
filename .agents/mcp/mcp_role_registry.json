      "tools": ["delta_security_scan"]
    },
    "dast-offat-zap": {
      "id": "dast-offat-zap",
      "category": "devsecops_sast_sbom_dast",
      "command": "node",
      "args": ["tools/mcp/mcp_omni_rag_server.mjs", "--profile=dast-offat-zap"],
      "patternOrigin": "cyproxio/mcp-for-security + OWASP ZAP / OFFAT",
      "audience": "urn:web-software-factory:mcp:dast-offat-zap",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
      "hitlGate": false,
      "allowedTargetHosts": ["127.0.0.1", "localhost"],
      "description": "Validación dinámica DAST de endpoints HTTP, cabeceras Sec-Fetch-*, CORS, CSRF y contratos API en staging local aislado.",
