    "d1-sqlite-readonly-mcp": {
      "id": "d1-sqlite-readonly-mcp",
      "category": "vcs_fs_db_edge",
      "command": "node",
      "args": ["tools/mcp/mcp_omni_rag_server.mjs", "--profile=d1-sqlite-readonly-mcp"],
      "audience": "urn:web-software-factory:mcp:d1-sqlite-readonly-mcp",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
      "hitlGate": false,
      "blockedSqlKeywords": ["INSERT", "UPDATE", "DELETE", "DROP", "ALTER", "TRUNCATE", "REPLACE", "ATTACH", "PRAGMA writable_schema"],
      "description": "Conector D1/SQLite estrictamente Read-Only (solo SELECT/EXPLAIN) para qa-auditor, bloqueando mutaciones SQL.",
      "tools": ["d1_readonly_query"]
    },
    "github-mcp": {
      "id": "github-mcp",
      "category": "vcs_fs_db_edge",
