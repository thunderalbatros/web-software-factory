{
  "schema": "mcp-zero-trust-role-registry-2026.10",
  "version": "1.0.0",
  "securityStandard": "OWASP-MCP-Top-10-2025 (MCP01-MCP10) + OWASP-Agentic-Top-10 (ASI01-ASI10)",
  "globalPolicies": {
    "additionalPropertiesFalseRequired": true,
    "forbidSensitiveHeaders": ["x-mcp-header", "x-mcp-untrusted", "x-api-key-raw", "authorization-Forward"],
    "sessionIdGenerator": "CSPRNG (crypto.randomUUID / crypto.randomBytes)",
    "audienceValidationRequired": true,
    "expectedAudience": "urn:web-software-factory:mcp-gateway:2026",
    "forbidShadowMcpServers": true,
    "hitlConfirmationRequiredFor": [
      "production-deploy",
      "d1-schema-drop",
      "git-force-push",
      "secret-rotation"
    ],
    "maxInlineResponseTokens": 1200,
    "overflowReportDirectories": {
      "root": ".agents/security_reports",
      "semgrep": ".agents/security_reports/.semgrep",
      "trivy": ".agents/security_reports/.trivy",
      "sbom": ".agents/security_reports/.sbom",
      "headroomCcr": ".cache/headroom_ccr"
    }
  },
  "servers": {
    "omni-rag-ast": {
      "id": "omni-rag-ast",
      "aliasIds": ["web-factory-omni-rag"],
      "category": "knowledge_and_documentation",
      "command": "node",
      "args": ["tools/mcp/mcp_omni_rag_server.mjs"],
      "audience": "urn:web-software-factory:mcp:omni-rag-ast",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
      "hitlGate": false,
      "description": "RAG híbrido (SQLite FTS5 + MiniSearch), search_codebase_ast (cocoindex-code) y discover_tools (MCP-Zero).",
      "tools": [
        "discover_tools",
        "headroom_retrieve",
        "search_codebase_ast",
        "codemode_execute_batch",
        "omni_rag_query",
        "code_graph_query",
        "omni_rag_stats",
        "factory_style_catalog",
        "factory_compile_tokens",
        "factory_run_audit",
        "factory_repomap_pagerank",
        "factory_ast_slice_function",
        "factory_jev_evaluate_diff",
        "factory_run_local_commerce_rls_harness",
        "jev_memory_pipeline_gate",
        "xstate_validate_transition"
      ]
    },
    "context7": {
      "id": "context7",
      "category": "knowledge_and_documentation",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "audience": "urn:web-software-factory:mcp:context7",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
      "hitlGate": false,
      "description": "Documentación oficial en vivo por versión exacta (Upstash Context7 / ctx7).",
      "tools": ["resolve-library-id", "query-docs"]
    },
    "chrome-devtools": {
      "id": "chrome-devtools",
      "category": "visual_inspection_and_60fps",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--user-data-dir=./.cache/chrome-devtools-mcp"
      ],
      "audience": "urn:web-software-factory:mcp:chrome-devtools",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
      "hitlGate": false,
      "description": "Trazas CDP de GPU/CPU, JSHeapUsedSize, LayoutDuration y árbol completo de accesibilidad (FullAXTree).",
      "tools": ["performance_get_metrics", "accessibility_get_full_ax_tree", "evaluate_script", "take_snapshot"]
    },
    "playwright": {
      "id": "playwright",
      "category": "visual_inspection_and_60fps",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"],
      "audience": "urn:web-software-factory:mcp:playwright",
      "readOnly": true,
      "csprngSession": true,
      "additionalPropertiesFalse": true,
