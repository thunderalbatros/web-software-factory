  "waves": {
    "wave_1_spec": {
      "waveName": "Ola 1 — Descubrimiento y Especificación (Spec-Kit)",
      "roles": ["product-spec-architect", "tech-scout"],
      "allowedServers": ["omni-rag-ast", "context7", "rea-agents"],
      "writeCodeAllowed": false
    },
    "wave_2_builders": {
      "waveName": "Ola 2 — Roles Constructores (Implementación Creador)",
      "roles": [
        "senior-coder",
        "ux-designer",
        "motion-engineer",
        "copywriting-cro-strategist",
        "edge-fullstack-architect",
        "seo-aeo-geo-architect"
      ],
      "allowedServers": ["filesystem-scoped", "semgrep-mcp", "omni-rag-ast", "context7", "blender-mcp"],
      "blockedPaths": [".agents/sealed_envelope_evals/"],
      "writeCodeAllowed": true
    },
    "wave_3a_coverage_verifier": {
      "waveName": "Ola 3A — Rol Verificador de Cobertura (100% Read-Only)",
      "roles": ["qa-auditor"],
      "allowedServers": ["git-readonly-mcp", "d1-sqlite-readonly-mcp", "chrome-devtools", "playwright"],
      "writeCodeAllowed": false
