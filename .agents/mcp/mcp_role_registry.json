    "filesystem-scoped": {
      "id": "filesystem-scoped",
      "category": "vcs_fs_db_edge",
      "command": "node",
      "args": ["tools/mcp/mcp_omni_rag_server.mjs", "--profile=filesystem-scoped"],
      "audience": "urn:web-software-factory:mcp:filesystem-scoped",
