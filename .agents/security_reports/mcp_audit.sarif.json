{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "WebFactory-MCP-Security-Auditor",
          "informationUri": "https://owasp.org/www-project-mcp-top-10/",
          "version": "2026.10.0",
          "rules": [
            {
              "id": "MCP-01",
              "name": "StrictInputSchemaAdditionalPropertiesFalse",
              "shortDescription": {
                "text": "All MCP tool inputSchema objects enforce \"additionalProperties\": false."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP01:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-02",
              "name": "NoExposedSensitiveMcpHeaders",
              "shortDescription": {
                "text": "Forbids sensitive x-mcp-header exposure across MCP server definitions."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP02:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-03",
              "name": "NoPlaintextStaticCredentials",
              "shortDescription": {
                "text": "Prohibits plaintext static credentials or API keys in .mcp.json and role registry."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP01:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-04",
              "name": "CsprngSessionIdGeneration",
              "shortDescription": {
                "text": "Generates MCP session IDs exclusively via CSPRNG (crypto.randomUUID / crypto.randomBytes), forbidding Math.random()."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP03:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-05",
              "name": "TokenAudienceValidation",
              "shortDescription": {
                "text": "Enforces strict token Audience Validation (urn:web-software-factory:mcp-gateway:2026) before tool dispatch."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP02:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-06",
              "name": "ShadowMcpServerBlock",
              "shortDescription": {
                "text": "Blocks unregistered Shadow MCP Servers at both configuration and runtime enforcement layers."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP04:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-07",
              "name": "HitlGateForProductionMutations",
              "shortDescription": {
                "text": "Requires mandatory Human-in-the-Loop (HITL) approval gate for infrastructure or production deployment mutations."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP05:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-08",
              "name": "CreatorVerifierRoleWaveSplit",
              "shortDescription": {
                "text": "Enforces sub-millisecond (<0.1ms) Creator-Verifier role partitioning across Wave 1, Wave 2, Wave 3A, and Wave 3B."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP06:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-09",
              "name": "SealedEnvelopeEvalIsolation",
              "shortDescription": {
                "text": "Blocks Wave 2 builder agents from reading .agents/sealed_envelope_evals/ via filesystem-scoped."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP06:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-10",
              "name": "ReadOnlyGitAndD1SqliteForVerifier",
              "shortDescription": {
                "text": "Restricts Wave 3A qa-auditor to 100% Read-Only Git and SQLite/D1 queries (blocking INSERT, UPDATE, DELETE, DROP)."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP07:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-11",
              "name": "SemgrepMcpRegressionRuleBridge",
              "shortDescription": {
                "text": "Exposes security_check, semgrep_scan, get_abstract_syntax_tree, and write_custom_semgrep_rule in semgrep-mcp."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP08:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-12",
              "name": "DeltaSecurityScannerExecutiveCompression",
              "shortDescription": {
                "text": "Persists SAST, IaC CIS, and CycloneDX SBOM reports to .agents/security_reports/{.semgrep,.trivy,.sbom} with <300 token summary."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP08:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-13",
              "name": "DastOffatZapIsolatedStagingScope",
              "shortDescription": {
                "text": "Confines DAST OWASP ZAP / OFFAT dynamic API & Sec-Fetch/CORS/CSRF probes to isolated localhost staging."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP09:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-14",
              "name": "GithubNhiPushProtectionAndNoAutoMerge",
              "shortDescription": {
                "text": "Enforces pre-commit secret scanning with push protection and Non-Human Identity (NHI) PRs with auto-merge blocked."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP09:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-15",
              "name": "McpOutputSpilloverCompressor1200Tokens",
              "shortDescription": {
                "text": "Automatically offloads any MCP tool response > 1,200 tokens to disk and returns a lightweight executive pointer."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP10:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-16",
              "name": "ToolAndMemoryPoisoningGuard",
              "shortDescription": {
                "text": "Inspects MCP tool schemas and RAG memory chunks against Tool Poisoning and Memory Poisoning vectors."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP04:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-17",
              "name": "OutboundPiiAndTokenRedaction",
              "shortDescription": {
                "text": "Redacts outbound PII and sensitive bearer tokens before any external MCP payload transmission."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP02:2025",
                "status": "PASS"
              }
            },
            {
              "id": "MCP-18",
              "name": "DeterministicCircuitBreakerCeiling",
              "shortDescription": {
                "text": "Halts runaway MCP tool loops via a deterministic 2-retry circuit breaker in agent_governance_kernel.mjs."
              },
              "properties": {
                "owaspMcpTop10": "OWASP-MCP10:2025",
                "status": "PASS"
              }
            }
          ]
        }
