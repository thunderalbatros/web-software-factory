{
  "schema": "agentic-mcp-unified-config-2026.10",
  "activeDiscoveryProtocol": "MCP-Zero (discover_tools)",
  "roleRegistryPath": ".agents/mcp/mcp_role_registry.json",
  "governanceGateway": "tools/intelligence/agent_governance_kernel.mjs",
  "sarifAuditor": "tools/audit/mcp_security_auditor.mjs",
  "mcpServers": {
    "omni-rag-ast": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs"],
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "disabled": false
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--user-data-dir=./.cache/chrome-devtools-mcp"
      ],
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"],
      "disabled": false
    },
    "semgrep-mcp": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs", "--profile=semgrep-mcp"],
      "disabled": false
    },
    "delta-security-scanner": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs", "--profile=delta-security-scanner"],
      "disabled": false
    },
    "dast-offat-zap": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs", "--profile=dast-offat-zap"],
      "disabled": false
    },
    "filesystem-scoped": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs", "--profile=filesystem-scoped"],
      "disabled": false
    },
    "git-readonly-mcp": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs", "--profile=git-readonly-mcp"],
      "disabled": false
    },
    "d1-sqlite-readonly-mcp": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs", "--profile=d1-sqlite-readonly-mcp"],
      "disabled": false
    },
    "github-mcp": {
      "command": "node",
      "args": ["./tools/mcp/mcp_omni_rag_server.mjs", "--profile=github-mcp"],
      "disabled": false
    },
    "cloudflare-edge-mcp": {
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare"],
      "disabled": false
    }
  }
}
