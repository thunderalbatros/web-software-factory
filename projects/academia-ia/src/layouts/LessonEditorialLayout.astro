---
import BaseLayout from './BaseLayout.astro';
import ToolsStackPanel from '../components/ToolsStackPanel.astro';
import VideoTriangulationFacade from '../components/VideoTriangulationFacade.astro';
import TiktokenExplorer from '../components/TiktokenExplorer.astro';
import SocraticTutorShell from '../components/SocraticTutorShell.astro';
import { getLevelBundle } from '../lib/academy-data.mjs';

const { frontmatter = {} } = Astro.props;
const levelNumber = Number(frontmatter.level || 1);
const levelSlug = frontmatter.levelSlug || 'principiante';
const unescoLabel = frontmatter.unescoStageLabel || 'Adquirir';
const canonicalPath = `/niveles/${levelSlug}/`;
const lessonSlug = frontmatter.lessonSlug || `semilla-${levelSlug}`;

const bundle = getLevelBundle(levelSlug);
---
<BaseLayout
  title={`${frontmatter.title || 'Lección Semilla'} — Academia Libre`}
  description={frontmatter.description || bundle.levelConfig.scope_es}
  levelNumber={levelNumber}
  canonicalPath={canonicalPath}
>
  <div class="level-kicker">
    <span>Nivel {levelNumber} · UNESCO {unescoLabel}</span>
    <span>·</span>
    <span>Licencia {bundle.charter.content_license}</span>
  </div>

  <article aria-label={frontmatter.title}>
    <slot />
  </article>

  <ToolsStackPanel
    tools={bundle.tools}
    heading={` Ecosistema abierto y alternativas sin tarjeta (${levelSlug})`.trim()}
  />

  <VideoTriangulationFacade
    videos={bundle.videos}
    sectionHeading={`Videos complementarios verificados del nivel ${levelNumber} (${bundle.videos.length} fuentes)`}
  />

  {frontmatter.hasTokenizerLab === true && (
    <TiktokenExplorer
      sampleText={frontmatter.tiktokenSample || 'Un modelo de lenguaje divide cada frase en tokens antes de calcular probabilidades.'}
    />
  )}

  <SocraticTutorShell
    levelId={levelSlug}
    lessonSlug={lessonSlug}
    defaultQuestion={frontmatter.defaultTutorQuestion || '¿Cómo aplico esta idea sin exponer datos privados?'}
  />

  <section
    class="editorial-panel"
    data-lesson-progress
    data-lesson-slug={lessonSlug}
    aria-label="Registro de avance en esta lección"
  >
    <h2 class="editorial-h2">Registrar avance en este nivel (local y sincronizable)</h2>
    <p>
      Tu progreso se guarda localmente en <code>Dexie</code> sin requerir registro. Si iniciaste sesión en <a href="/perfil/">tu perfil</a>, los puntos se acreditarán de forma idempotente en tu historial.
    </p>
    <div class="card-actions-row">
      <button type="button" class="btn-primary" data-lesson-complete-read>
        Marcar lectura completada (+25 XP)
      </button>
      <button type="button" class="btn-editorial" data-lesson-complete-quiz>
        Acreditar autoevaluación del nivel (+50 XP)
      </button>
    </div>
    <p class="tutor-status-line" data-lesson-progress-status aria-live="polite"></p>
  </section>
</BaseLayout>

