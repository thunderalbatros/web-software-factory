{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "projects/**/dist/**",
    "deliverables/**",
    ".sandboxes/**",
    ".cache/**"
  ]
}
