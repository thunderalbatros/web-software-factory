# ============================================================================
# WEB SOFTWARE FACTORY STUDIO & ACADEMIA IA — ENVIRONMENT TEMPLATE (.env.example)
# ============================================================================
# Copy to `.env` (gitignored) only when running cloud ingestion, batch embeddings,
# or weekly automated reports. Local builds, runtime gates, and `academia-ia`
# operate at $0.00 server cost without any secret keys.

# ----------------------------------------------------------------------------
# 1. GCP & VERTEX AI FINOPS ($70 USD Promotional Credit Shield)
# ----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GCP_BATCH_BUCKET=
USE_VERTEX_AI=true
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# 2. ACADEMIA IA — CLEAN-ROOM VIDEO TRANSCRIPT & METADATA TRIANGULATION
# ----------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ----------------------------------------------------------------------------
# 3. CTO HITL GOVERNANCE & WEEKLY EVOLUTION NOTIFICATIONS (Optional)
# ----------------------------------------------------------------------------
CTO_EMAIL_TO=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
ADMIN_API_SECRET=
JEV_API_KEY=

# ----------------------------------------------------------------------------
# 4. COMMERCIAL SAAS / MARKETING PROFILES ONLY (Not used in `education`)
# ----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
