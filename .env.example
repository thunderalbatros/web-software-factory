# ============================================================================
# WEB SOFTWARE FACTORY STUDIO — CONFIGURACIÓN DE ENTORNO (.env.example)
# ============================================================================
# Destinatario preconfigurado por defecto para el Reporte Semanal de los Lunes 08:00 AM (ARG):
CTO_EMAIL_TO=tomasbermudez777@gmail.com

# ----------------------------------------------------------------------------
# OPCIONES DE TRANSPORTE DE CORREO (Configurá cualquiera de las 3 en tu .env o GitHub Secrets)
# ----------------------------------------------------------------------------
# Modo 1 (Recomendado - Gratis): Gmail Directo vía SMTP TLS (smtp.gmail.com:465)
# Generá una "Contraseña de Aplicación" de 16 letras en tu cuenta de Google (Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones):
GMAIL_APP_PASSWORD=

# Modo 2: Resend API (https://resend.com - 3.000 emails/mes gratis)
RESEND_API_KEY=

# Modo 3: Webhook de n8n o Google Apps Script
N8N_EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
